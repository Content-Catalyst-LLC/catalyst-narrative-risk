{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/input/1.3.0",
  "title": "Catalyst Narrative Risk Input 1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "source_type": {
      "enum": [
        "official_or_primary",
        "peer_reviewed_or_audited",
        "reputable_secondary",
        "internal_unreviewed",
        "single_report_or_media",
        "social_or_anecdotal",
        "unknown"
      ]
    },
    "evidence_strength": {
      "enum": [
        "strong",
        "moderate",
        "limited",
        "weak",
        "unclear"
      ]
    },
    "uncertainty": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "narrative_volatility": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "stakeholder_pressure": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "time_sensitivity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "consequences": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ],
      "default": "moderate"
    },
    "review_status": {
      "enum": [
        "reviewed",
        "partly_reviewed",
        "not_reviewed"
      ],
      "default": "partly_reviewed"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "method_notes": {
      "type": "string",
      "maxLength": 50000,
      "default": ""
    },
    "claims": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/claim_input"
      },
      "default": []
    },
    "sources": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/source_input"
      },
      "default": []
    },
    "evidence_items": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/evidence_input"
      },
      "default": []
    },
    "relationships": {
      "type": "array",
      "maxItems": 2000000,
      "items": {
        "$ref": "#/$defs/relationship_input"
      },
      "default": []
    }
  },
  "$defs": {
    "claim_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:claim:sha256:[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "claim_type": {
          "enum": [
            "factual",
            "causal",
            "predictive",
            "normative",
            "recommendation",
            "interpretive"
          ],
          "default": "factual"
        },
        "role": {
          "enum": [
            "primary",
            "supporting",
            "context"
          ],
          "default": "supporting"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "default": ""
        }
      }
    },
    "source_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:source:sha256:[0-9a-f]{64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "source_type": {
          "enum": [
            "official_or_primary",
            "peer_reviewed_or_audited",
            "reputable_secondary",
            "internal_unreviewed",
            "single_report_or_media",
            "social_or_anecdotal",
            "unknown"
          ],
          "default": "unknown"
        },
        "creators": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "default": []
        },
        "publisher": {
          "type": "string",
          "maxLength": 5000,
          "default": ""
        },
        "published_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -10000,
          "maximum": 9999
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "accessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "identifiers": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/identifier_input"
          },
          "default": []
        },
        "independence_group": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "duplicate_of_source_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^urn:catalyst:narrative-risk:source:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "directness": {
          "enum": [
            "direct",
            "indirect",
            "mixed",
            "unknown"
          ],
          "default": "unknown"
        },
        "freshness": {
          "enum": [
            "current",
            "aging",
            "stale",
            "unknown"
          ],
          "default": "unknown"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_input"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "default": ""
        }
      }
    },
    "identifier_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "value"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "doi",
            "isbn",
            "issn",
            "url",
            "handle",
            "ark",
            "catalog",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      }
    },
    "provenance_input": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "acquisition_method": {
          "enum": [
            "manual",
            "knowledge_library",
            "catalyst_data",
            "api",
            "document_import",
            "other"
          ],
          "default": "manual"
        },
        "imported_from": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 5000
        },
        "imported_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "excerpt"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:evidence:sha256:[0-9a-f]{64}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:source:sha256:[0-9a-f]{64}$"
        },
        "evidence_type": {
          "enum": [
            "quote",
            "data",
            "finding",
            "observation",
            "method",
            "context"
          ],
          "default": "finding"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "locator": {
          "type": "string",
          "maxLength": 5000,
          "default": ""
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "default": ""
        }
      }
    },
    "relationship_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "evidence_id",
        "relation_type",
        "strength"
      ],
      "properties": {
        "relationship_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:relationship:sha256:[0-9a-f]{64}$"
        },
        "claim_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:claim:sha256:[0-9a-f]{64}$"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:evidence:sha256:[0-9a-f]{64}$"
        },
        "relation_type": {
          "enum": [
            "support",
            "qualify",
            "contradict",
            "contextualize",
            "unresolved"
          ]
        },
        "strength": {
          "enum": [
            "strong",
            "moderate",
            "limited",
            "weak",
            "unclear"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "default": ""
        }
      }
    }
  }
}
