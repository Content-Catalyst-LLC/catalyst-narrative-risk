{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/security-report/1.10.0",
  "title": "Narrative Risk Security Readiness Report 1.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "report_version",
    "generated_at",
    "environment",
    "status",
    "readiness_score",
    "checks",
    "blocking_check_ids",
    "recommendations",
    "report_sha256"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "report_version": {
      "const": "1.10.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "needs_attention",
        "blocked",
        "development_only"
      ]
    },
    "readiness_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "category",
          "status",
          "severity",
          "message",
          "remediation"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "blocking_check_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
