{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/record/1.1.0",
  "title": "Catalyst Narrative Risk Record 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "contract",
    "identifiers",
    "generated_at",
    "normalized_input",
    "method_snapshot",
    "method_snapshot_sha256",
    "calculations",
    "interpretation",
    "human_decision",
    "reproducibility"
  ],
  "properties": {
    "record_type": {
      "const": "catalyst_narrative_risk_record"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version"
      ],
      "properties": {
        "contract_id": {
          "const": "urn:catalyst:narrative-risk:contract:canonical"
        },
        "contract_version": {
          "const": "1.1.0"
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "case_id",
        "method_id",
        "schema_id",
        "input_schema_id"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
        },
        "method_id": {
          "const": "urn:catalyst:narrative-risk:method:transparent-heuristic"
        },
        "schema_id": {
          "const": "https://sustainablecatalyst.com/schemas/narrative-risk/record/1.1.0"
        },
        "input_schema_id": {
          "const": "https://sustainablecatalyst.com/schemas/narrative-risk/input/1.1.0"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "normalized_input": {
      "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/input/1.1.0"
    },
    "method_snapshot": {
      "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/method-snapshot/1.1.0"
    },
    "method_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calculations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "raw_total",
        "multiplier",
        "scaled_score",
        "risk_score",
        "threshold"
      ],
      "properties": {
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_type",
            "evidence_strength",
            "uncertainty",
            "narrative_volatility",
            "stakeholder_pressure",
            "time_sensitivity",
            "consequences",
            "review_status",
            "source_count"
          ],
          "properties": {
            "source_type": {
              "$ref": "#/$defs/component"
            },
            "evidence_strength": {
              "$ref": "#/$defs/component"
            },
            "uncertainty": {
              "$ref": "#/$defs/component"
            },
            "narrative_volatility": {
              "$ref": "#/$defs/component"
            },
            "stakeholder_pressure": {
              "$ref": "#/$defs/component"
            },
            "time_sensitivity": {
              "$ref": "#/$defs/component"
            },
            "consequences": {
              "$ref": "#/$defs/component"
            },
            "review_status": {
              "$ref": "#/$defs/component"
            },
            "source_count": {
              "$ref": "#/$defs/component"
            }
          }
        },
        "raw_total": {
          "type": "integer",
          "minimum": 0
        },
        "multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scaled_score": {
          "type": "number",
          "minimum": 0
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "minimum",
            "maximum"
          ],
          "properties": {
            "level": {
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "minimum": {
              "type": "integer"
            },
            "maximum": {
              "type": "integer"
            }
          }
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "flags",
        "review_actions",
        "decision_note"
      ],
      "properties": {
        "risk_level": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human_decision": {
      "$ref": "#/$defs/human_decision"
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_input_sha256",
        "record_payload_sha256"
      ],
      "properties": {
        "canonical_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_schema_version",
        "from_method_version",
        "migrated_at",
        "warnings"
      ],
      "properties": {
        "from_schema_version": {
          "const": "1.0.1"
        },
        "from_method_version": {
          "const": "1.0.1"
        },
        "migrated_at": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_value",
        "weight",
        "rationale",
        "remediation"
      ],
      "properties": {
        "input_value": {},
        "weight": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "disposition",
        "reviewer_id",
        "reviewer_name",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "pending_review",
            "reviewed"
          ]
        },
        "disposition": {
          "enum": [
            "undecided",
            "approved",
            "approved_with_conditions",
            "revise",
            "rejected"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
