{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/method-snapshot/1.1.0",
  "title": "Catalyst Narrative Risk Method Snapshot 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method_id",
    "method_version",
    "name",
    "description",
    "algorithm",
    "controlled_vocabulary_id",
    "controlled_vocabulary_version",
    "defaults",
    "weights",
    "components",
    "interpretation",
    "human_decision_boundary"
  ],
  "properties": {
    "method_id": {
      "const": "urn:catalyst:narrative-risk:method:transparent-heuristic"
    },
    "method_version": {
      "const": "1.1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "component_order",
        "multiplier",
        "rounding",
        "minimum_score",
        "maximum_score",
        "thresholds"
      ],
      "properties": {
        "type": {
          "const": "weighted_additive_v1"
        },
        "component_order": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_type",
              "evidence_strength",
              "uncertainty",
              "narrative_volatility",
              "stakeholder_pressure",
              "time_sensitivity",
              "consequences",
              "review_status",
              "source_count"
            ]
          }
        },
        "multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rounding": {
          "const": "half_up"
        },
        "minimum_score": {
          "const": 0
        },
        "maximum_score": {
          "const": 100
        },
        "thresholds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "minimum",
              "maximum"
            ],
            "properties": {
              "level": {
                "enum": [
                  "Low",
                  "Medium",
                  "High"
                ]
              },
              "minimum": {
                "type": "integer"
              },
              "maximum": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "controlled_vocabulary_id": {
      "const": "urn:catalyst:narrative-risk:vocabularies:canonical"
    },
    "controlled_vocabulary_version": {
      "const": "1.1.0"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "evidence_strength",
        "uncertainty",
        "narrative_volatility",
        "stakeholder_pressure",
        "time_sensitivity",
        "consequences",
        "review_status",
        "source_count",
        "method_notes"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "official_or_primary",
            "peer_reviewed_or_audited",
            "reputable_secondary",
            "internal_unreviewed",
            "single_report_or_media",
            "social_or_anecdotal",
            "unknown"
          ],
          "default": "reputable_secondary"
        },
        "evidence_strength": {
          "enum": [
            "strong",
            "moderate",
            "limited",
            "weak",
            "unclear"
          ],
          "default": "moderate"
        },
        "uncertainty": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        "narrative_volatility": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        "stakeholder_pressure": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        "time_sensitivity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        "consequences": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ],
          "default": "moderate"
        },
        "review_status": {
          "enum": [
            "reviewed",
            "partly_reviewed",
            "not_reviewed"
          ],
          "default": "partly_reviewed"
        },
        "source_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "default": 2
        },
        "method_notes": {
          "type": "string",
          "maxLength": 50000,
          "default": ""
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "evidence_strength",
        "three_level_scale",
        "consequences",
        "review_status",
        "source_count_penalties"
      ],
      "properties": {
        "source_type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "official_or_primary",
            "peer_reviewed_or_audited",
            "reputable_secondary",
            "internal_unreviewed",
            "single_report_or_media",
            "social_or_anecdotal",
            "unknown"
          ],
          "properties": {
            "official_or_primary": {
              "type": "integer",
              "minimum": 0
            },
            "peer_reviewed_or_audited": {
              "type": "integer",
              "minimum": 0
            },
            "reputable_secondary": {
              "type": "integer",
              "minimum": 0
            },
            "internal_unreviewed": {
              "type": "integer",
              "minimum": 0
            },
            "single_report_or_media": {
              "type": "integer",
              "minimum": 0
            },
            "social_or_anecdotal": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence_strength": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strong",
            "moderate",
            "limited",
            "weak",
            "unclear"
          ],
          "properties": {
            "strong": {
              "type": "integer",
              "minimum": 0
            },
            "moderate": {
              "type": "integer",
              "minimum": 0
            },
            "limited": {
              "type": "integer",
              "minimum": 0
            },
            "weak": {
              "type": "integer",
              "minimum": 0
            },
            "unclear": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "three_level_scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "medium",
            "high"
          ],
          "properties": {
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "consequences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "moderate",
            "high",
            "critical"
          ],
          "properties": {
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "moderate": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "critical": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "review_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewed",
            "partly_reviewed",
            "not_reviewed"
          ],
          "properties": {
            "reviewed": {
              "type": "integer",
              "minimum": 0
            },
            "partly_reviewed": {
              "type": "integer",
              "minimum": 0
            },
            "not_reviewed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "source_count_penalties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum",
              "maximum",
              "weight"
            ],
            "properties": {
              "minimum": {
                "type": "integer",
                "minimum": 0
              },
              "maximum": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "weight": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "evidence_strength",
        "uncertainty",
        "narrative_volatility",
        "stakeholder_pressure",
        "time_sensitivity",
        "consequences",
        "review_status",
        "source_count"
      ],
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "input_field",
            "weight_table",
            "rationale",
            "remediation"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "input_field": {
              "type": "string",
              "minLength": 1
            },
            "weight_table": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "remediation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_notes",
        "flag_rules",
        "action_rules"
      ],
      "properties": {
        "decision_notes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Low",
            "Medium",
            "High"
          ],
          "properties": {
            "Low": {
              "type": "string",
              "minLength": 1
            },
            "Medium": {
              "type": "string",
              "minLength": 1
            },
            "High": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "flag_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "action_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "human_decision_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "field": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "operator": {
          "enum": [
            "lte",
            "eq",
            "neq",
            "in",
            "any_eq",
            "if_empty",
            "if_empty_and_score_lt"
          ]
        },
        "value": {},
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
