{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/publication-package/1.10.0",
  "title": "Narrative Risk Publication Package 1.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "case_id",
    "briefing_id",
    "status",
    "slug",
    "package_version",
    "generated_at",
    "classification",
    "public_safe",
    "artifacts",
    "package_sha256"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "briefing_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "published",
        "revoked",
        "superseded"
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "package_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification": {
      "enum": [
        "internal",
        "confidential",
        "restricted",
        "public"
      ]
    },
    "public_safe": {
      "type": "boolean"
    },
    "public_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "media_type",
          "filename",
          "content_encoding",
          "content",
          "content_sha256",
          "size_bytes"
        ],
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown",
              "html",
              "pdf",
              "csv",
              "jsonld"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "content_encoding": {
            "enum": [
              "utf-8",
              "base64"
            ]
          },
          "content": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
