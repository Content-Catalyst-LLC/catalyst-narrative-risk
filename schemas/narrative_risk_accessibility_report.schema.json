{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/accessibility-report/1.10.0",
  "title": "Narrative Risk Accessibility Audit 1.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "report_version",
    "generated_at",
    "plugin_root",
    "status",
    "score",
    "control_count",
    "label_count",
    "button_count",
    "typed_button_count",
    "checks",
    "report_sha256"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "report_version": {
      "const": "1.10.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "plugin_root": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "control_count": {
      "type": "integer",
      "minimum": 0
    },
    "label_count": {
      "type": "integer",
      "minimum": 0
    },
    "button_count": {
      "type": "integer",
      "minimum": 0
    },
    "typed_button_count": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "category",
          "status",
          "severity",
          "message",
          "remediation"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
