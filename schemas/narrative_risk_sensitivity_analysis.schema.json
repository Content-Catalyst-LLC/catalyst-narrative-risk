{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/sensitivity-analysis/2.0.0",
  "title": "Catalyst Narrative Risk Sensitivity Analysis 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id",
    "comparison_id",
    "case_id",
    "baseline_member_id",
    "dimensions",
    "generated_at",
    "baseline",
    "runs",
    "drivers",
    "analysis_sha256"
  ],
  "properties": {
    "analysis_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "baseline_member_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 20
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_score",
        "risk_level",
        "component_weights"
      ],
      "properties": {
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "risk_level": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "component_weights": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "dimension",
          "value",
          "risk_score",
          "risk_level",
          "delta_from_baseline",
          "component_weights"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
          },
          "dimension": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "value": {},
          "risk_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "risk_level": {
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "delta_from_baseline": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          },
          "component_weights": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      }
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "min_score",
          "max_score",
          "range",
          "direction"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "min_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "max_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "range": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "direction": {
            "enum": [
              "increases_risk",
              "decreases_risk",
              "mixed",
              "no_change"
            ]
          }
        }
      }
    },
    "analysis_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
