{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/governance-decision/2.0.0",
  "title": "Catalyst Narrative Risk Governance Decision 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "case_id",
    "revision_id",
    "workflow_id",
    "assignment_id",
    "stage",
    "disposition",
    "decided_by",
    "decided_by_name",
    "decider_role",
    "decided_at",
    "rationale",
    "conditions",
    "required_wording",
    "publication_restrictions",
    "disclosures",
    "valid_until",
    "reassessment_at",
    "supersedes_decision_id"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "assignment_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "enum": [
        "intake",
        "domain",
        "editorial",
        "legal",
        "compliance",
        "final"
      ]
    },
    "disposition": {
      "enum": [
        "approve",
        "approve_with_conditions",
        "revise",
        "reject",
        "waive"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "decided_by_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "decider_role": {
      "enum": [
        "reviewer",
        "domain_reviewer",
        "editorial_reviewer",
        "legal_reviewer",
        "compliance_reviewer",
        "final_approver",
        "administrator"
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "required_wording": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "publication_restrictions": {
      "type": "array",
      "items": {
        "enum": [
          "internal_only",
          "embargoed",
          "no_public_claim",
          "attribution_required",
          "legal_review_required",
          "disclosure_required"
        ]
      },
      "uniqueItems": true
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reassessment_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes_decision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
