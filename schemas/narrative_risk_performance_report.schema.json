{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/performance-report/2.0.0",
  "title": "Narrative Risk Performance Budget Report 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "report_version",
    "generated_at",
    "status",
    "case_count_sampled",
    "case_id",
    "metrics",
    "report_sha256"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "report_version": {
      "const": "2.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "case_count_sampled": {
      "type": "integer",
      "minimum": 0
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "value",
          "budget",
          "unit",
          "status"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "budget": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "enum": [
              "ms",
              "bytes"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
