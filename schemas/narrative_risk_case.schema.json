{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/case/1.3.0",
  "title": "Catalyst Narrative Risk Case 1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "organization_id", "project_id", "title", "summary", "status", "priority", "tags", "archived", "archived_at", "created_at", "updated_at", "current_revision", "latest_record_id", "revision_count", "review_event_count"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"},
    "organization_id": {"type": ["string", "null"], "maxLength": 500},
    "project_id": {"type": ["string", "null"], "maxLength": 500},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "summary": {"type": "string", "maxLength": 20000},
    "status": {"enum": ["draft", "active", "in_review", "approved", "closed"]},
    "priority": {"enum": ["low", "normal", "high", "critical"]},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 100}, "uniqueItems": true, "maxItems": 100},
    "archived": {"type": "boolean"},
    "archived_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "current_revision": {"type": "integer", "minimum": 0},
    "latest_record_id": {"type": ["string", "null"], "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"},
    "revision_count": {"type": "integer", "minimum": 0},
    "review_event_count": {"type": "integer", "minimum": 0}
  }
}
