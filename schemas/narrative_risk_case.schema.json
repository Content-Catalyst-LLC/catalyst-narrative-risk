{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/case/1.10.0",
  "title": "Catalyst Narrative Risk Case 1.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "organization_id",
    "project_id",
    "title",
    "summary",
    "status",
    "priority",
    "tags",
    "archived",
    "archived_at",
    "created_at",
    "updated_at",
    "current_revision",
    "latest_record_id",
    "revision_count",
    "review_event_count",
    "assignment_count",
    "governance_decision_count",
    "workflow_status",
    "current_stage",
    "final_disposition",
    "approval_valid_until",
    "reassessment_at",
    "publication_allowed",
    "monitoring_snapshot_count",
    "watch_count",
    "open_alert_count",
    "last_monitored_at",
    "monitoring_status",
    "stakeholder_actor_count",
    "stakeholder_relationship_count",
    "stakeholder_incentive_count",
    "stakeholder_pressure_count",
    "stakeholder_consequence_count",
    "suggested_stakeholder_pressure",
    "comparison_set_count",
    "scenario_count",
    "evaluated_scenario_count",
    "sensitivity_analysis_count",
    "decision_studio_handoff_count",
    "comparative_status",
    "publication_briefing_count",
    "publication_package_count",
    "public_embed_count",
    "platform_handoff_count",
    "publication_status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "summary": {
      "type": "string",
      "maxLength": 20000
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "in_review",
        "approved",
        "closed"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "archived": {
      "type": "boolean"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_revision": {
      "type": "integer",
      "minimum": 0
    },
    "latest_record_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "revision_count": {
      "type": "integer",
      "minimum": 0
    },
    "review_event_count": {
      "type": "integer",
      "minimum": 0
    },
    "assignment_count": {
      "type": "integer",
      "minimum": 0
    },
    "governance_decision_count": {
      "type": "integer",
      "minimum": 0
    },
    "workflow_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "draft",
        "active",
        "blocked",
        "changes_required",
        "approved",
        "rejected",
        "expired",
        "closed",
        null
      ]
    },
    "current_stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "intake",
        "domain",
        "editorial",
        "legal",
        "compliance",
        "final",
        null
      ]
    },
    "final_disposition": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approve",
        "approve_with_conditions",
        "revise",
        "reject",
        "waive",
        null
      ]
    },
    "approval_valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reassessment_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "publication_allowed": {
      "type": "boolean"
    },
    "monitoring_snapshot_count": {
      "type": "integer",
      "minimum": 0
    },
    "watch_count": {
      "type": "integer",
      "minimum": 0
    },
    "open_alert_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_monitored_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "monitoring_status": {
      "enum": [
        "not_monitored",
        "current",
        "attention_required",
        "critical"
      ]
    },
    "stakeholder_actor_count": {
      "type": "integer",
      "minimum": 0
    },
    "stakeholder_relationship_count": {
      "type": "integer",
      "minimum": 0
    },
    "stakeholder_incentive_count": {
      "type": "integer",
      "minimum": 0
    },
    "stakeholder_pressure_count": {
      "type": "integer",
      "minimum": 0
    },
    "stakeholder_consequence_count": {
      "type": "integer",
      "minimum": 0
    },
    "suggested_stakeholder_pressure": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "high",
        null
      ]
    },
    "comparison_set_count": {
      "type": "integer",
      "minimum": 0
    },
    "scenario_count": {
      "type": "integer",
      "minimum": 0
    },
    "evaluated_scenario_count": {
      "type": "integer",
      "minimum": 0
    },
    "sensitivity_analysis_count": {
      "type": "integer",
      "minimum": 0
    },
    "decision_studio_handoff_count": {
      "type": "integer",
      "minimum": 0
    },
    "comparative_status": {
      "enum": [
        "not_started",
        "comparison_ready",
        "scenario_ready"
      ]
    },
    "publication_briefing_count": {
      "type": "integer",
      "minimum": 0
    },
    "publication_package_count": {
      "type": "integer",
      "minimum": 0
    },
    "public_embed_count": {
      "type": "integer",
      "minimum": 0
    },
    "platform_handoff_count": {
      "type": "integer",
      "minimum": 0
    },
    "publication_status": {
      "enum": [
        "not_started",
        "briefing_ready",
        "package_ready",
        "published"
      ]
    }
  }
}
