{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/narrative-map/1.8.0",
  "title": "Catalyst Narrative Risk Narrative Map 1.8.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_version",
    "primary_node_id",
    "selected_variant_id",
    "nodes",
    "links",
    "wording_variants",
    "wording_comparisons",
    "analysis"
  ],
  "properties": {
    "map_version": {
      "const": "1.8.0"
    },
    "primary_node_id": {
      "type": "string",
      "pattern": "^urn:catalyst:narrative-risk:node:sha256:[0-9a-f]{64}$"
    },
    "selected_variant_id": {
      "type": "string",
      "pattern": "^urn:catalyst:narrative-risk:variant:sha256:[0-9a-f]{64}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "wording_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "wording_comparisons": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 200
        },
        "context": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "text",
        "node_type",
        "role",
        "claim_id",
        "parent_node_id",
        "confidence_language",
        "modality",
        "entities",
        "geography",
        "time_scope",
        "quantities",
        "baseline",
        "notes"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:node:sha256:[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "node_type": {
          "enum": [
            "factual_claim",
            "causal_claim",
            "predictive_claim",
            "normative_claim",
            "recommendation",
            "assumption",
            "context",
            "unknown"
          ]
        },
        "role": {
          "enum": [
            "primary",
            "supporting",
            "context"
          ]
        },
        "claim_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^urn:catalyst:narrative-risk:claim:sha256:[0-9a-f]{64}$"
        },
        "parent_node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^urn:catalyst:narrative-risk:node:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_language": {
          "enum": [
            "absolute",
            "confident",
            "qualified",
            "tentative",
            "unknown"
          ]
        },
        "modality": {
          "enum": [
            "asserts",
            "suggests",
            "predicts",
            "recommends",
            "questions"
          ]
        },
        "entities": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "geography": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "time_scope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "quantities": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string",
                "maxLength": 200
              },
              "context": {
                "type": "string",
                "maxLength": 5000
              }
            }
          }
        },
        "baseline": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 5000
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "from_node_id",
        "to_node_id",
        "relation_type",
        "strength",
        "notes"
      ],
      "properties": {
        "link_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:link:sha256:[0-9a-f]{64}$"
        },
        "from_node_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:node:sha256:[0-9a-f]{64}$"
        },
        "to_node_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:node:sha256:[0-9a-f]{64}$"
        },
        "relation_type": {
          "enum": [
            "decomposes_to",
            "depends_on",
            "causes",
            "predicts",
            "supports",
            "qualifies",
            "contradicts",
            "contextualizes",
            "recommends",
            "sequence"
          ]
        },
        "strength": {
          "enum": [
            "strong",
            "moderate",
            "limited",
            "unclear"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "label",
        "text",
        "audience",
        "status",
        "notes"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:variant:sha256:[0-9a-f]{64}$"
        },
        "label": {
          "type": "string",
          "maxLength": 1000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "audience": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "current",
            "draft",
            "preferred",
            "rejected",
            "archived"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_variant_id",
        "to_variant_id",
        "similarity",
        "added_terms",
        "removed_terms",
        "absolute_language_delta",
        "uncertainty_language_delta",
        "causal_language_delta",
        "risk_direction"
      ],
      "properties": {
        "from_variant_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:variant:sha256:[0-9a-f]{64}$"
        },
        "to_variant_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:variant:sha256:[0-9a-f]{64}$"
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "added_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absolute_language_delta": {
          "type": "integer"
        },
        "uncertainty_language_delta": {
          "type": "integer"
        },
        "causal_language_delta": {
          "type": "integer"
        },
        "risk_direction": {
          "enum": [
            "higher",
            "lower",
            "same",
            "mixed"
          ]
        }
      }
    },
    "node_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "word_count",
        "ambiguous_terms",
        "causal_markers",
        "predictive_markers",
        "normative_markers",
        "compound_indicator_count",
        "confidence_mismatch"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:node:sha256:[0-9a-f]{64}$"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "causal_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "predictive_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "normative_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compound_indicator_count": {
          "type": "integer",
          "minimum": 0
        },
        "confidence_mismatch": {
          "type": "boolean"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "code",
        "severity",
        "node_ids",
        "message",
        "remediation"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "^urn:catalyst:narrative-risk:issue:sha256:[0-9a-f]{64}$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:catalyst:narrative-risk:node:sha256:[0-9a-f]{64}$"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_node",
        "issues",
        "cycles",
        "summary"
      ],
      "properties": {
        "per_node": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node_analysis"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^urn:catalyst:narrative-risk:node:sha256:[0-9a-f]{64}$"
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_count",
            "link_count",
            "mapped_claim_count",
            "unmapped_claim_count",
            "issue_count",
            "severity_counts",
            "map_status",
            "review_ready"
          ],
          "properties": {
            "node_count": {
              "type": "integer",
              "minimum": 1
            },
            "link_count": {
              "type": "integer",
              "minimum": 0
            },
            "mapped_claim_count": {
              "type": "integer",
              "minimum": 0
            },
            "unmapped_claim_count": {
              "type": "integer",
              "minimum": 0
            },
            "issue_count": {
              "type": "integer",
              "minimum": 0
            },
            "severity_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "properties": {
                "low": {
                  "type": "integer",
                  "minimum": 0
                },
                "medium": {
                  "type": "integer",
                  "minimum": 0
                },
                "high": {
                  "type": "integer",
                  "minimum": 0
                },
                "critical": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "map_status": {
              "enum": [
                "complete",
                "partial",
                "needs_review"
              ]
            },
            "review_ready": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
