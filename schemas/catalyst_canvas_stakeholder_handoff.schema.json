{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/handoff/catalyst-canvas-stakeholders/1.7.0",
  "title": "Catalyst Canvas Stakeholder Handoff 1.7.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_type",
    "handoff_version",
    "canvas_id",
    "exported_at",
    "stakeholders",
    "relationships"
  ],
  "properties": {
    "handoff_type": {
      "const": "catalyst_canvas_stakeholder_handoff"
    },
    "handoff_version": {
      "const": "1.7.0"
    },
    "canvas_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canvas_stakeholder_id",
          "name",
          "actor_type"
        ],
        "properties": {
          "canvas_stakeholder_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "actor_type": {
            "enum": [
              "individual",
              "community",
              "organization",
              "company",
              "government",
              "regulator",
              "funder",
              "media",
              "research_institution",
              "advocacy_group",
              "public",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "influence": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "stance": {
            "enum": [
              "supportive",
              "neutral",
              "opposed",
              "mixed",
              "unknown"
            ]
          },
          "disclosure_status": {
            "enum": [
              "not_required",
              "disclosed",
              "partially_disclosed",
              "not_disclosed",
              "unknown"
            ]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_canvas_stakeholder_id",
          "target_canvas_stakeholder_id",
          "relationship_type"
        ],
        "properties": {
          "source_canvas_stakeholder_id": {
            "type": "string"
          },
          "target_canvas_stakeholder_id": {
            "type": "string"
          },
          "relationship_type": {
            "enum": [
              "funds",
              "employs",
              "governs",
              "regulates",
              "represents",
              "advises",
              "partners_with",
              "competes_with",
              "depends_on",
              "supplies",
              "influences",
              "amplifies",
              "contests",
              "benefits_from",
              "harmed_by",
              "other"
            ]
          },
          "strength": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical",
              "unknown"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
