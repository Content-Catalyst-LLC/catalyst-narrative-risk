{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/workspace-bundle/1.7.0",
  "title": "Catalyst Narrative Risk Portable Case Bundle 1.7.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_type",
    "bundle_version",
    "exported_at",
    "case",
    "revisions",
    "review_events",
    "activity",
    "bundle_sha256",
    "governance_workflow",
    "review_assignments",
    "governance_decisions",
    "monitoring_snapshots",
    "monitoring_comparisons",
    "watchlists",
    "monitoring_alerts",
    "site_intelligence_events",
    "stakeholder_actors",
    "stakeholder_relationships",
    "stakeholder_incentives",
    "stakeholder_pressures",
    "stakeholder_consequences",
    "stakeholder_intelligence",
    "catalyst_canvas_handoffs"
  ],
  "properties": {
    "bundle_type": {
      "const": "catalyst_narrative_risk_case_bundle"
    },
    "bundle_version": {
      "const": "1.7.0"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "case": {
      "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/case/1.7.0"
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/revision/1.7.0"
      }
    },
    "review_events": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/review-event/1.7.0"
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activity_id",
          "case_id",
          "event_type",
          "entity_id",
          "payload",
          "created_at"
        ],
        "properties": {
          "activity_id": {
            "type": "integer",
            "minimum": 1
          },
          "case_id": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "entity_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "payload": {
            "type": "object"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "governance_workflow": {
      "anyOf": [
        {
          "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/governance-workflow/1.7.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_assignments": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/review-assignment/1.7.0"
      }
    },
    "governance_decisions": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/governance-decision/1.7.0"
      }
    },
    "monitoring_snapshots": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/monitoring-snapshot/1.7.0"
      }
    },
    "monitoring_comparisons": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/monitoring-comparison/1.7.0"
      }
    },
    "watchlists": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/watchlist/1.7.0"
      }
    },
    "monitoring_alerts": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/monitoring-alert/1.7.0"
      }
    },
    "site_intelligence_events": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/handoff/site-intelligence-monitoring/1.7.0"
      }
    },
    "stakeholder_actors": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/stakeholder-actor/1.7.0"
      }
    },
    "stakeholder_relationships": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/stakeholder-relationship/1.7.0"
      }
    },
    "stakeholder_incentives": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/stakeholder-incentive/1.7.0"
      }
    },
    "stakeholder_pressures": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/stakeholder-pressure/1.7.0"
      }
    },
    "stakeholder_consequences": {
      "type": "array",
      "items": {
        "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/stakeholder-consequence/1.7.0"
      }
    },
    "stakeholder_intelligence": {
      "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/stakeholder-intelligence/1.7.0"
    },
    "catalyst_canvas_handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handoff_id",
          "case_id",
          "canvas_id",
          "handoff",
          "handoff_sha256",
          "imported_at"
        ],
        "properties": {
          "handoff_id": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
          },
          "canvas_id": {
            "type": "string"
          },
          "handoff": {
            "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/handoff/catalyst-canvas-stakeholders/1.7.0"
          },
          "handoff_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "imported_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
