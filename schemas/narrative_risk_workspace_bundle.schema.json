{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/workspace-bundle/1.3.0",
  "title": "Catalyst Narrative Risk Portable Case Bundle 1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_type", "bundle_version", "exported_at", "case", "revisions", "review_events", "activity", "bundle_sha256"],
  "properties": {
    "bundle_type": {"const": "catalyst_narrative_risk_case_bundle"},
    "bundle_version": {"const": "1.3.0"},
    "exported_at": {"type": "string", "format": "date-time"},
    "case": {"$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/case/1.3.0"},
    "revisions": {"type": "array", "items": {"$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/revision/1.3.0"}},
    "review_events": {"type": "array", "items": {"$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/review-event/1.3.0"}},
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity_id", "case_id", "event_type", "entity_id", "payload", "created_at"],
        "properties": {
          "activity_id": {"type": "integer", "minimum": 1},
          "case_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"},
          "event_type": {"type": "string", "minLength": 1, "maxLength": 100},
          "entity_id": {"type": ["string", "null"], "maxLength": 500},
          "payload": {"type": "object"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
