{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/review-template/1.5.0",
  "title": "Catalyst Narrative Risk Review Template 1.5.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "name",
    "description",
    "stages",
    "default_due_days",
    "escalation_days",
    "created_at",
    "updated_at",
    "created_by",
    "active"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "required",
          "required_role",
          "instructions"
        ],
        "properties": {
          "stage": {
            "enum": [
              "intake",
              "domain",
              "editorial",
              "legal",
              "compliance",
              "final"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "required_role": {
            "enum": [
              "reviewer",
              "domain_reviewer",
              "editorial_reviewer",
              "legal_reviewer",
              "compliance_reviewer",
              "final_approver",
              "administrator"
            ]
          },
          "instructions": {
            "type": "string",
            "maxLength": 20000
          }
        }
      }
    },
    "default_due_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "escalation_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "active": {
      "type": "boolean"
    }
  }
}
