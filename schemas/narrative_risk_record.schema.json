{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/record/1.2.0",
  "title": "Catalyst Narrative Risk Record 1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "contract",
    "identifiers",
    "generated_at",
    "normalized_input",
    "evidence_ledger",
    "method_snapshot",
    "method_snapshot_sha256",
    "calculations",
    "interpretation",
    "human_decision",
    "reproducibility"
  ],
  "properties": {
    "record_type": {
      "const": "catalyst_narrative_risk_record"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version"
      ],
      "properties": {
        "contract_id": {
          "const": "urn:catalyst:narrative-risk:contract:canonical"
        },
        "contract_version": {
          "const": "1.2.0"
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "case_id",
        "method_id",
        "schema_id",
        "input_schema_id",
        "ledger_schema_id"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
        },
        "method_id": {
          "const": "urn:catalyst:narrative-risk:method:transparent-heuristic"
        },
        "schema_id": {
          "const": "https://sustainablecatalyst.com/schemas/narrative-risk/record/1.2.0"
        },
        "input_schema_id": {
          "const": "https://sustainablecatalyst.com/schemas/narrative-risk/input/1.2.0"
        },
        "ledger_schema_id": {
          "const": "https://sustainablecatalyst.com/schemas/narrative-risk/evidence-ledger/1.2.0"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "normalized_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "source_type",
        "evidence_strength",
        "uncertainty",
        "narrative_volatility",
        "stakeholder_pressure",
        "time_sensitivity",
        "consequences",
        "review_status",
        "source_count",
        "method_notes"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "source_type": {
          "enum": [
            "official_or_primary",
            "peer_reviewed_or_audited",
            "reputable_secondary",
            "internal_unreviewed",
            "single_report_or_media",
            "social_or_anecdotal",
            "unknown"
          ]
        },
        "evidence_strength": {
          "enum": [
            "strong",
            "moderate",
            "limited",
            "weak",
            "unclear"
          ]
        },
        "uncertainty": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "narrative_volatility": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "stakeholder_pressure": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "time_sensitivity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "consequences": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        },
        "review_status": {
          "enum": [
            "reviewed",
            "partly_reviewed",
            "not_reviewed"
          ]
        },
        "source_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "method_notes": {
          "type": "string"
        }
      }
    },
    "evidence_ledger": {
      "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/evidence-ledger/1.2.0"
    },
    "method_snapshot": {
      "$ref": "https://sustainablecatalyst.com/schemas/narrative-risk/method-snapshot/1.2.0"
    },
    "method_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calculations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "raw_total",
        "multiplier",
        "scaled_score",
        "risk_score",
        "threshold"
      ],
      "properties": {
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_type",
            "evidence_strength",
            "uncertainty",
            "narrative_volatility",
            "stakeholder_pressure",
            "time_sensitivity",
            "consequences",
            "review_status",
            "source_count"
          ],
          "properties": {
            "source_type": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "evidence_strength": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "uncertainty": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "narrative_volatility": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "stakeholder_pressure": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "time_sensitivity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "consequences": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "review_status": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "source_count": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_value",
                "weight",
                "rationale",
                "remediation"
              ],
              "properties": {
                "input_value": {},
                "weight": {
                  "type": "integer",
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "raw_total": {
          "type": "integer",
          "minimum": 0
        },
        "multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scaled_score": {
          "type": "number",
          "minimum": 0
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "minimum",
            "maximum"
          ],
          "properties": {
            "level": {
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "minimum": {
              "type": "integer"
            },
            "maximum": {
              "type": "integer"
            }
          }
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "flags",
        "review_actions",
        "decision_note"
      ],
      "properties": {
        "risk_level": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "disposition",
        "reviewer_id",
        "reviewer_name",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "pending_review",
            "reviewed"
          ]
        },
        "disposition": {
          "enum": [
            "undecided",
            "approved",
            "approved_with_conditions",
            "revise",
            "rejected"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_input_sha256",
        "evidence_ledger_sha256",
        "record_payload_sha256"
      ],
      "properties": {
        "canonical_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_ledger_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_schema_version",
        "from_method_version",
        "migrated_at",
        "warnings"
      ],
      "properties": {
        "from_schema_version": {
          "enum": [
            "1.0.1",
            "1.1.0"
          ]
        },
        "from_method_version": {
          "enum": [
            "1.0.1",
            "1.1.0"
          ]
        },
        "migrated_at": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
