{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/narrative-risk/stakeholder-actor/1.10.0",
  "title": "Catalyst Narrative Risk Stakeholder Actor 1.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "case_id",
    "name",
    "actor_type",
    "description",
    "interests",
    "influence",
    "stance",
    "disclosure_status",
    "external_id",
    "notes",
    "created_at",
    "created_by"
  ],
  "properties": {
    "actor_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "actor_type": {
      "enum": [
        "individual",
        "community",
        "organization",
        "company",
        "government",
        "regulator",
        "funder",
        "media",
        "research_institution",
        "advocacy_group",
        "public",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "interests": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "influence": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "stance": {
      "enum": [
        "supportive",
        "neutral",
        "opposed",
        "mixed",
        "unknown"
      ]
    },
    "disclosure_status": {
      "enum": [
        "not_required",
        "disclosed",
        "partially_disclosed",
        "not_disclosed",
        "unknown"
      ]
    },
    "external_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "notes": {
      "type": "string",
      "maxLength": 20000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  }
}
