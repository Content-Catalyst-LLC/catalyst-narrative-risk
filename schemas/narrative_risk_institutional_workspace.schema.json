            },
            "outbound_routes": {
              "type": "integer",
              "minimum": 0
            },
            "inbound_routes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "catalyst_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "events",
            "outbound_routes",
            "inbound_routes"
          ],
          "properties": {
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "outbound_routes": {
              "type": "integer",
              "minimum": 0
            },
            "inbound_routes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "site_intelligence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "events",
            "outbound_routes",
            "inbound_routes"
          ],
          "properties": {
            "events": {
              "type": "integer",
