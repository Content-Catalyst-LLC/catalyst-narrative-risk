            "inbound_routes"
          ],
          "properties": {
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "outbound_routes": {
              "type": "integer",
              "minimum": 0
            },
            "inbound_routes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "catalyst_analytics": {
